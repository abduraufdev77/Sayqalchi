# Optional custom provider. Public MyMemory translation needs no .env or key.
# Import this file in Yoz → Settings → Translation service after filling it in.
# Use your actual HTTPS service origin. Do not commit your real API key.
TRANSLATION_API_URL=https://translation.example.com
TRANSLATION_API_KEY=

# Enable only for an explicitly trusted plain-HTTP development service.
TRANSLATION_ALLOW_INSECURE_HTTP=false
