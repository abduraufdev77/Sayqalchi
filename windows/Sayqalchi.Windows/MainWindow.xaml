<Window x:Class="Sayqalchi.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sayqalchi" Width="1000" Height="740" MinWidth="780" MinHeight="580" Background="#F8F8F4" Foreground="{StaticResource Ink}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#EFEFE8"><DockPanel Margin="24,30">
   <StackPanel DockPanel.Dock="Top">
    <Border Width="48" Height="48" Background="{StaticResource MarkGradient}" CornerRadius="13" HorizontalAlignment="Left"><TextBlock Text="ö" FontSize="39" HorizontalAlignment="Center" Margin="0,-4,0,0"/></Border>
    <TextBlock Text="Sayqalchi" FontSize="25" FontWeight="SemiBold" Margin="0,12,0,4"/>
    <TextBlock Text="A little shift in your letters." Foreground="{StaticResource Muted}" FontSize="11"/>
    <Button Content="Playground" Margin="0,35,0,10" Click="PlaygroundClick"/>
    <Button Content="Settings" Margin="0,0,0,20" Click="SettingsClick"/>
   </StackPanel>
   <StackPanel VerticalAlignment="Bottom"><TextBlock Text="YOUR WRITING, YOUR CHOICE" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="Your default tool after a pause.&#10;Other tools when you choose." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,12,0,18"/><TextBlock Text="SAYQALCHI FOR WINDOWS" FontSize="9"/></StackPanel>
  </DockPanel></Border>
  <DockPanel Grid.Column="1" Margin="28,26">
   <Grid DockPanel.Dock="Top" Margin="0,0,0,25"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="PageTitle" Text="Playground" FontSize="14" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Enable / pause  ⇧ × 2" Background="{StaticResource Green}" Click="ToggleClick"/></Grid>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <StackPanel x:Name="PlaygroundPane">
      <TextBlock Text="Your words. A little more polished." FontSize="32" TextWrapping="Wrap" Margin="0,0,0,15"/>
      <TextBlock Text="Type here, or enable Sayqalchi and write in another app. Pause to see your result at the top of the screen." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,20"/>
      <UniformGrid Columns="4" Margin="0,0,0,16"><Button Content="Aa  Format" Tag="Format" Click="ToolClick"/><Button Content="◎  Translate" Tag="Translate" Click="ToolClick"/><Button Content="▣  Izohchi" Tag="Izohchi" Click="ToolClick"/><Button Content="▤  Document" Tag="Document" Click="ToolClick"/></UniformGrid>
      <TextBox AutomationProperties.AutomationId="PlaygroundEditor" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="210" VerticalScrollBarVisibility="Auto" FontSize="18"/>
      <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,10" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Error}" Foreground="#B64B25" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="320" FontSize="18" Foreground="#B64B25"/>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Copy result" IsEnabled="{Binding CanCopy}" Click="CopyClick"/><Button Content="More ↗" Click="MoreClick"/></StackPanel>
     </StackPanel>
     <StackPanel x:Name="SettingsPane" Visibility="Collapsed">
      <TextBlock Text="A flow that fits you." FontSize="32" Margin="0,0,0,25"/>
      <TextBlock Text="Default service" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Only this tool runs after a typing pause. Other tools run when opened." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/>
      <ComboBox x:Name="DefaultToolBox" SelectionChanged="DefaultChanged" Margin="0,0,0,25"/>
      <TextBlock Text="Translation languages" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,25"><ComboBox Width="155" ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Source}"/><TextBlock Text="→" Margin="3,7,12,0"/><ComboBox Width="155" ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Target}"/></StackPanel>
      <TextBlock Text="Translation service" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <CheckBox x:Name="CustomProvider" Content="Use my custom service" Cursor="Hand" Margin="0,0,0,15"/>
      <TextBlock Text="Service URL"/><TextBox x:Name="ServiceUrl" Margin="0,6,0,12"/>
      <TextBlock Text="API key"/><PasswordBox x:Name="ApiKey" Padding="10" Margin="0,6,0,12"/>
      <CheckBox x:Name="AllowHttp" Content="Allow unencrypted HTTP for this service" Cursor="Hand" Margin="0,0,0,10"/>
      <TextBlock Text="HTTP exposes your text and key to the network. HTTPS is recommended." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
      <Button Content="Save translation settings" HorizontalAlignment="Left" Margin="0,15,0,20" Click="SaveClick"/>
      <TextBlock Text="MyMemory is available without a key or login (5,000 characters/day). It may retain submitted text. Formatting, document tools and Latin ↔ Cyrillic stay on your device. Only the selected default service runs automatically; translation sends the draft, Izohchi sends only the query. Keys are encrypted for your Windows user using DPAPI." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12"/>
      <Button Content="MyMemory privacy &amp; limits ↗" HorizontalAlignment="Left" Margin="0,12,0,20" Click="PrivacyClick"/>
      <TextBlock Text="App exclusions" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Process names, separated by commas. Password fields, terminals and known password managers are always skipped." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,10"/>
      <TextBox x:Name="Exclusions"/>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,25,0,0"/>
      <TextBlock x:Name="SettingsNotice" TextWrapping="Wrap" Foreground="#427315" Margin="0,12,0,0"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </DockPanel>
 </Grid>
</Window>
